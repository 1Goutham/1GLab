# ─────────────────────────────────────────────────────────────────────────────
# 1G · AI Engineering OS — environment
# Copy to .env.local for development. On Vercel, set these in Project Settings.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (required). Local, Neon, Supabase or Vercel Postgres all work.
# For serverless, use the pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aios

# ── Authentication ──────────────────────────────────────────────────────────
# Required in production. Without OWNER_PASSWORD, local dev runs signed-in.
OWNER_EMAIL=gouthamgopinath.tsi@gmail.com
OWNER_PASSWORD=
# 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=

# Optional: Day 1 of the 180-day program (YYYY-MM-DD). Defaults to the seed date.
# PROGRAM_START_DATE=2026-09-28

# ── AI mentor (all optional) ────────────────────────────────────────────────
# Without any key the mentor runs in offline mode, answering from the curriculum.
# Pick explicitly with AI_PROVIDER, or the first key present wins
# (Anthropic → OpenAI → Gemini). AI_PROVIDER=offline forces offline mode.
AI_PROVIDER=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Mentor + AI task requests per 10 minutes.
# AI_RATE_LIMIT=40

# ── YouTube (optional) ──────────────────────────────────────────────────────
# Without it, curated resources (with "why watch this") are used.
YOUTUBE_API_KEY=
